# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
!contracts/broadcast/**/run-latest.json
# lib is committed as git submodules, the Foundry convention. Verified: with lib
# ignored, forge install alone does not restore it from foundry.lock and a fresh
# clone fails to build.

# Stylus and Rust
verifier/target/
**/*.rs.bk

# Node
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo

# Next.js
app/.next/
app/out/
.vercel

# Infra and local runs
infra/.anvil-state*
*.log

# OS
.DS_Store

# Python bytecode from tools/
__pycache__/
*.pyc

# echidna writes its corpus and its coverage next to the project, and crytic
# leaves an export directory behind. None of it is a source artifact.
contracts/echidna-corpus*/
contracts/crytic-export/

verifier/target/
verifier/stylus/target/
verifier/report.txt

# Deploy records are committed on purpose, so only the run logs are ignored.
contracts/broadcast/

# Backend local artefacts. infra/pinned-block.json and infra/accounts.json are
# committed on purpose, the rest is produced by a run on one laptop.
infra/fork-deployment.json
infra/chain.json
infra/.snapshot-id
# Regenerated from the live deployment by `make postman`, so the addresses in it
# are different on every laptop. The generator is committed, its output is not.
infra/postman/
# The worst case suite measures one laptop against one fork block, so its raw
# evidence and the report built from it stay local.
infra/.torture/
infra/torture-report.md
